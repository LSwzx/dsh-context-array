{
  "name": "dsh-context-array",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Locally hosted five-dimension memory and KV-cache-first context assembly for DeepSeek Harness.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "tools",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CONTRACT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "dsh-context-array-v4.1.md"
  ],
  "scripts": {
    "test": "node --test",
    "fetch-model": "node tools/fetch-model.mjs",
    "eval:retrieval": "node tools/eval-retrieval.mjs",
    "seed": "node tools/seed-memories.mjs",
    "usage": "node docs/analyze-usage.mjs",
    "savings": "node docs/savings-estimate.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
