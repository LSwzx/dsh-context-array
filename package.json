{
  "name": "dsh-context-array",
  "version": "1.0.2",
  "type": "module",
  "description": "Tonglian (通联): locally hosted multi-session memory for DeepSeek Harness — five-dimension memory, KV-cache-first context assembly, spaces, inbox, persona guard and a sidebar panel.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "tools",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRACT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "dsh-context-array-v4.1.md"
  ],
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test",
    "fetch-model": "node tools/fetch-model.mjs",
    "eval:retrieval": "node tools/eval-retrieval.mjs",
    "seed": "node tools/seed-memories.mjs",
    "usage": "node docs/analyze-usage.mjs",
    "savings": "node docs/savings-estimate.mjs"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "memory",
    "kv-cache",
    "sqlite",
    "embedding"
  ],
  "author": "LSwzx",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LSwzx/dsh-context-array.git"
  },
  "homepage": "https://github.com/LSwzx/dsh-context-array#readme",
  "bugs": {
    "url": "https://github.com/LSwzx/dsh-context-array/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots"
      ]
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
